<UserControl x:Class="iBackup.Client.App.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Backup Progress" Style="{StaticResource PageTitle}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Run now" Command="{Binding RunNowCommand}" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Pause" Command="{Binding PauseCommand}" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Resume" Command="{Binding ResumeCommand}" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,6" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Background="#F3F4F6" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <UniformGrid Columns="3">
                <StackPanel>
                    <TextBlock Text="State" Foreground="#6B7280" />
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentFolder}" FontSize="12" Foreground="#6B7280" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CurrentFile}" FontSize="12" Foreground="#6B7280" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Files" Foreground="#6B7280" />
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="{Binding FilesUploaded, Mode=OneWay}" /><Run Text=" uploaded · " /><Run Text="{Binding FilesSkipped, Mode=OneWay}" /><Run Text=" unchanged · " /><Run Text="{Binding FilesFailed, Mode=OneWay}" /><Run Text=" failed" />
                    </TextBlock>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Transferred" Foreground="#6B7280" />
                    <TextBlock Text="{Binding BytesUploadedText}" FontWeight="SemiBold" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <DataGrid ItemsSource="{Binding ActiveUploads}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding File}" Width="*" />
                <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="90" />
                <DataGridTextColumn Header="Chunks" Binding="{Binding Chunks}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

<UserControl x:Class="iBackup.Client.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Settings" Style="{StaticResource PageTitle}" />

        <StackPanel MaxWidth="480" HorizontalAlignment="Left">
            <TextBlock Text="Chunk size (MB)" Margin="0,0,0,4" />
            <TextBox Text="{Binding ChunkSizeMb, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12" />

            <TextBlock Text="Parallel file uploads" Margin="0,0,0,4" />
            <TextBox Text="{Binding ParallelFileUploads, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12" />

            <TextBlock Text="Parallel chunk uploads (per file)" Margin="0,0,0,4" />
            <TextBox Text="{Binding ParallelChunkUploads, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12" />

            <TextBlock Text="Compression" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding CompressionMethods}" SelectedItem="{Binding Compression}" Margin="0,0,0,12" />

            <TextBlock Text="Max retry attempts" Margin="0,0,0,4" />
            <TextBox Text="{Binding MaxRetryAttempts, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12" />

            <TextBlock Text="Data directory" Margin="0,0,0,4" />
            <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" Padding="6" Margin="0,0,0,16" />

            <Button Content="Apply" Command="{Binding ApplyCommand}" Padding="16,8"
                    HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"
                    Foreground="White" BorderThickness="0" />
            <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" Foreground="#16A34A" />
        </StackPanel>
    </DockPanel>
</UserControl>

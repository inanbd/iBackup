<UserControl x:Class="iBackup.Client.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Dashboard" Style="{StaticResource PageTitle}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Back up now" Command="{Binding RunBackupNowCommand}" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Pause" Command="{Binding PauseBackupsCommand}" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Resume" Command="{Binding ResumeBackupsCommand}" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Cancel current" Command="{Binding CancelBackupCommand}" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,6" />
        </StackPanel>

        <!-- Stat tiles -->
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,16">
            <Border Background="#F3F4F6" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Status" Foreground="#6B7280" />
                    <TextBlock Text="{Binding CurrentStatusText}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding NextRunText, StringFormat='Next run: {0}'}" Foreground="#6B7280" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Background="#F3F4F6" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Storage" Foreground="#6B7280" />
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <Run Text="{Binding StorageUsedText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding QuotaText, Mode=OneWay}" />
                    </TextBlock>
                    <ProgressBar Value="{Binding StoragePercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Background="#F3F4F6" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Last backup" Foreground="#6B7280" />
                    <TextBlock Text="{Binding LastBackupText}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FilesUploadedToday, StringFormat='{}{0} files uploaded today'}" Foreground="#6B7280" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Background="#F3F4F6" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="Activity" Foreground="#6B7280" />
                    <TextBlock Text="{Binding UploadSpeedText}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Foreground="#6B7280" FontSize="12">
                        <Run Text="{Binding QueueLength, Mode=OneWay}" /><Run Text=" queued · " /><Run Text="{Binding RegisteredDevices, Mode=OneWay}" /><Run Text=" devices" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Recent backups" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding RecentJobs}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Started" Binding="{Binding StartedAtUtc}" Width="140" />
                        <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="120" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        <DataGridTextColumn Header="Uploaded" Binding="{Binding UploadedFiles}" Width="80" />
                        <DataGridTextColumn Header="Failed" Binding="{Binding FailedFiles}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Recent activity" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding RecentActivity}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc}" Width="140" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>

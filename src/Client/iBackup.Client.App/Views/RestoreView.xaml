<UserControl x:Class="iBackup.Client.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Restore" Style="{StaticResource PageTitle}" />

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchPrefix, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                     ToolTip="Path prefix filter, e.g. Documents/Projects" />
            <CheckBox Grid.Column="1" Content="Include deleted" IsChecked="{Binding IncludeDeleted}"
                      VerticalAlignment="Center" Margin="8,0" />
            <Button Grid.Column="2" Content="Search" Command="{Binding SearchCommand}" Padding="14,6" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="Select all" Command="{Binding SelectAllCommand}" Padding="14,6" />
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                     ToolTip="Target folder (use the original backup folder path to restore in place)" />
            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseTargetCommand}" Padding="12,6" Margin="8,0" />
            <Button Grid.Column="2" Content="Restore selected" Command="{Binding RestoreSelectedCommand}" Padding="16,6"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap" />

        <DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Version" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="v" /><Run Text="{Binding VersionNumber, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding BackedUpAtUtc, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

<Window x:Class="iBackup.Client.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:iBackup.Client.App.ViewModels"
        xmlns:views="clr-namespace:iBackup.Client.App.Views"
        Title="iBackup" Height="760" Width="1180" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FoldersViewModel}"><views:FoldersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SchedulesViewModel}"><views:SchedulesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgressViewModel}"><views:ProgressView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestoreViewModel}"><views:RestoreView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}"><views:DevicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}"><views:LogsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar navigation -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Top" Text="iBackup"
                           Foreground="White" FontSize="20" FontWeight="Bold" Margin="16,20,16,24" />
                <StackPanel DockPanel.Dock="Top" IsEnabled="{Binding IsLoggedIn}">
                    <Button Style="{StaticResource NavButton}" Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="dashboard" />
                    <Button Style="{StaticResource NavButton}" Content="Backup Sources" Command="{Binding NavigateCommand}" CommandParameter="folders" />
                    <Button Style="{StaticResource NavButton}" Content="Schedules" Command="{Binding NavigateCommand}" CommandParameter="schedules" />
                    <Button Style="{StaticResource NavButton}" Content="Backup Progress" Command="{Binding NavigateCommand}" CommandParameter="progress" />
                    <Button Style="{StaticResource NavButton}" Content="Restore" Command="{Binding NavigateCommand}" CommandParameter="restore" />
                    <Button Style="{StaticResource NavButton}" Content="Devices" Command="{Binding NavigateCommand}" CommandParameter="devices" />
                    <Button Style="{StaticResource NavButton}" Content="Logs" Command="{Binding NavigateCommand}" CommandParameter="logs" />
                    <Button Style="{StaticResource NavButton}" Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="settings" />
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Content="Sign out"
                        Command="{Binding SignOutCommand}" Margin="0,0,0,12"
                        Visibility="{Binding IsLoggedIn, Converter={x:Static views:Converters.BoolToVisibility}}" />
            </DockPanel>
        </Border>

        <!-- Page host -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="24" />
    </Grid>
</Window>

{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=iBackup;Trusted_Connection=True;TrustServerCertificate=True;Max Pool Size=200"
  },
  "Jwt": {
    "SigningKey": "CHANGE-ME-to-a-random-secret-of-at-least-32-bytes!",
    "Issuer": "iBackup",
    "Audience": "iBackup.Clients",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },
  "Storage": {
    "RootPath": "Storage",
    "StreamBufferSize": 131072
  },
  "Database": {
    "InitializeOnStartup": false,
    "ScriptsPath": "database"
  },
  "Admin": {
    "BootstrapEmail": ""
  },
  "Maintenance": {
    "UploadCleanupIntervalMinutes": 30,
    "AbandonedUploadCutoffHours": 48,
    "RetentionSweepIntervalMinutes": 60
  },
  "RateLimiting": {
    "GlobalPermitPerMinute": 1200,
    "AuthPermitPerMinute": 20
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
